# 初次学习先使用 mock，不需要账号或 API Key。
LLM_MODE=mock

# 接入真实模型时改为 real，以下三个字段从模型服务控制台填写。
LLM_API_KEY=
# 北京地域的百炼旧域名仍可用；建议按官方文档改为你的业务空间专属域名。
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
# 百炼 qwen-plus 的 JSON 模式使用非思考模式；换其他服务商时按其文档修改。
LLM_DISABLE_THINKING=true
DATA_DIR=data

# true: honor proxy/CA environment; false: use the direct model route.
# For a provider requiring a proxy or enterprise custom CA, use true.
LLM_TRUST_ENV=false
